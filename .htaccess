RewriteEngine On

# Forcer HTTPS et enlever www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.herbier-provence\.com$ [NC]
RewriteRule ^ https://herbier-provence.com%{REQUEST_URI} [L,R=301]

# Pointer vers /herbierdeprovence
RewriteCond %{REQUEST_URI} !^/herbierdeprovence/
RewriteRule ^(.*)$ /herbierdeprovence/$1 [L]

# Erreur 404
ErrorDocument 404 /404.html

# Retirer .html de l'URL
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Ajouter automatiquement .html en interne
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]